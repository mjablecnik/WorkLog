# Server
PORT=3000
APP_ENV=production
# Required in production — behind a TLS-terminating proxy the runtime otherwise infers
# the wrong scheme and host. e.g. https://worklog.fly.dev
PUBLIC_ORIGIN=

# Database
DATABASE_URL=postgres://worklog:worklog@localhost:5432/worklog
# Integration and E2E tests only. MUST NOT equal DATABASE_URL — the suites truncate every table.
TEST_DATABASE_URL=postgres://worklog:worklog@localhost:5432/worklog_test
DB_QUERY_TIMEOUT_SECONDS=5
DB_POOL_MAX=10

# Authentication — see ./scripts/hash-passphrase.sh to produce WORKLOG_PASSPHRASE_HASH
WORKLOG_API_TOKEN=your-32-plus-character-random-token-here
WORKLOG_PASSPHRASE_HASH=

# Time zone and day boundary
TIMEZONE=Europe/Prague
DAY_START_HOUR=3

# The interface's expected working-hours window (Gauge_Window). GAUGE_END may wrap
# past midnight — the default 06:00-00:00 describes eighteen hours.
GAUGE_START=06:00
GAUGE_END=00:00
EVENING_HOUR=21

# When ALLOW_DAY_BOUNDARY_CHANGE is unset, the server refuses to start if the stored
# Day_Boundary_Config disagrees with TIMEZONE/DAY_START_HOUR above.
ALLOW_DAY_BOUNDARY_CHANGE=false

# Timers and floors
MAX_OPEN_SESSION_HOURS=12
MIN_INTERVAL_SECONDS=60
SESSION_DURATION_HOURS=720

# HTTP
LOG_LEVEL=info
CORS_ORIGINS=
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120
