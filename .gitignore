# Environment files — never commit real values
.env
.env.local
.env.*.local
.env.*
!.env.example

# SvelteKit / Vite
.svelte-kit/
build/
node_modules/
.vercel/
.output/

# Paraglide compiles into the source tree
src/lib/paraglide/

# Test and tooling output — anchored to the root, so it never shadows src/routes/api/coverage/
/coverage/
playwright-report/
test-results/
tests/tmp/

# Backups produced by scripts/backup.sh
backups/

# The Fly org choice scripts/deploy.sh persists after the first /dev/tty prompt —
# a per-developer/per-machine preference, never a project setting.
.fly-org

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
tmp/
*.log
